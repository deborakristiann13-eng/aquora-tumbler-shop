        <div id="cart-backdrop" onclick="toggleCart()" class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm transition-opacity"></div>

        <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
            <div id="cart-panel" class="w-screen max-w-md bg-white shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300 ease-in-out pointer-events-auto">
                <!-- Drawer Header -->
                <div class="p-6 border-b border-slate-100 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-bag-shopping text-aquora-600 text-xl"></i>
                        <h3 class="text-lg font-bold text-slate-900">Keranjang Belanja</h3>
                    </div>
                    <button onclick="toggleCart()" class="text-slate-400 hover:text-slate-600 p-2">
                        <i class="fa-solid fa-xmark text-xl"></i>
                    </button>
                </div>

                <!-- Cart Items Container -->
                <div id="cart-items" class="flex-1 overflow-y-auto p-6 space-y-4">
                    <!-- Dynamic Cart Items -->
                </div>

                <!-- Drawer Footer -->
                <div class="p-6 border-t border-slate-100 bg-slate-50 space-y-4">
                    <div class="flex items-center justify-between text-base font-bold text-slate-900">
                        <span>Total Pembayaran</span>
                        <span id="cart-total" class="text-aquora-600">Rp 0</span>
                    </div>
                    <p class="text-xs text-slate-500">Pesanan akan diteruskan langsung ke WhatsApp Admin Aquora untuk konfirmasi & pembayaran.</p>
                    <button onclick="checkoutWhatsApp()" class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl shadow-lg shadow-emerald-600/20 flex items-center justify-center gap-2 transition-all">
                        <i class="fa-brands fa-whatsapp text-lg"></i>
                        Beli via WhatsApp
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Product Detail Modal -->
    <div id="product-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden">
        <div class="bg-white rounded-3xl max-w-2xl w-full overflow-hidden shadow-2xl relative transform transition-all">
            <button onclick="closeProductModal()" class="absolute top-4 right-4 z-10 w-9 h-9 bg-white/80 hover:bg-white rounded-full flex items-center justify-center text-slate-500 hover:text-slate-800 transition-colors shadow-sm">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
            
            <div id="modal-content" class="grid grid-cols-1 md:grid-cols-2">
                <!-- Modal content injected via JavaScript -->
            </div>
        </div>
    </div>

    <!-- Notification Toast -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 bg-slate-900 text-white px-5 py-3.5 rounded-2xl shadow-xl flex items-center gap-3 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
        <i class="fa-solid fa-circle-check text-emerald-400 text-lg"></i>
        <span id="toast-message" class="text-sm font-medium">Produk berhasil ditambahkan!</span>
    </div>

    <!-- JavaScript Logic -->
    <script>
        // Data Produk Tumbler Aquora
        const products = [
            {
                id: 1,
                name: "Aquora Hydro Pro 750ml",
                category: "Active",
                price: 249000,
                originalPrice: 299000,
                rating: 4.9,
                reviews: 128,
                image: "https://images.unsplash.com/photo-1602143407151-7111542de6e8?auto=format&fit=crop&w=600&q=80",
                badge: "Terlaris",
                colors: ["#0284c7", "#0f172a", "#10b981"],
                colorNames: ["Ocean Blue", "Midnight Black", "Emerald Green"],
                desc: "Tumbler olahraga performa tinggi dengan ketahanan suhu hingga 24 jam. Dilengkapi penutup saringan dan handle fleksibel."
            },
            {
                id: 2,
                name: "Aquora Minimalist Office 500ml",
                category: "Office",
                price: 189000,
                originalPrice: 229000,
                rating: 4.8,
                reviews: 95,
                image: "https://images.unsplash.com/photo-1544816155-12df9643f363?auto=format&fit=crop&w=600&q=80",
                badge: "Baru",
                colors: ["#f43f5e", "#64748b", "#e2e8f0"],
                colorNames: ["Rose Gold", "Slate Grey", "Pure White"],
                desc: "Desain ramping khas kantoran modern dengan permukaan matte anti gores. Pas untuk segala ukuran cup holder mobil."
            },
            {
                id: 3,
                name: "Aquora Travel Mug Thermal 380ml",
                category: "Mini",
                price: 159000,
                originalPrice: 199000,
                rating: 4.7,
                reviews: 74,
                image: "https://images.unsplash.com/photo-1517256064527-09c73fc73e38?auto=format&fit=crop&w=600&q=80",
                badge: "Diskon",
                colors: ["#d97706", "#0f172a"],
                colorNames: ["Amber Gold", "Matte Black"],
                desc: "Cangkir travel vakum khusus penikmat kopi dan teh. Menjaga suhu kopi tetap hangat sempurna sepanjang jam kerja."
            },
            {
                id: 4,
                name: "Aquora Giant Hydration 1200ml",
                category: "Active",
                price: 329000,
                originalPrice: 389000,
                rating: 5.0,
                reviews: 210,
                image: "https://images.unsplash.com/photo-1589365278144-c9e705f843ba?auto=format&fit=crop&w=600&q=80",
                badge: "Jumbo",
                colors: ["#0284c7", "#8b5cf6"],
                colorNames: ["Deep Sea", "Purple Mist"],
                desc: "Kapasitas esktra besar 1.2 Liter untuk memenuhi kebutuhan hidrasi seharian penuh tanpa perlu sering mengisi ulang."
            },
            {
                id: 5,
                name: "Aquora Slim Pocket 350ml",
                category: "Mini",
                price: 139000,
                originalPrice: 169000,
                rating: 4.8,
                reviews: 62,
                image: "https://images.unsplash.com/photo-1523362628745-0c100150b504?auto=format&fit=crop&w=600&q=80",
                badge: "Ringan",
                colors: ["#f472b6", "#38bdf8"],
                colorNames: ["Pastel Pink", "Sky Blue"],
                desc: "Ukuran mungil, sangat ringan, dan pas masuk ke dalam tas kecil atau pouch wanita. Praktis dibawa bepergian."
            },
            {
                id: 6,
                name: "Aquora Executive Stainless Steel",
                category: "Office",
                price: 279000,
                originalPrice: 320000,
                rating: 4.9,
                reviews: 88,
                image: "https://images.unsplash.com/photo-1570831739435-660143a59dfe?auto=format&fit=crop&w=600&q=80",
                badge: "Premium",
                colors: ["#334155", "#0f172a"],
                colorNames: ["Titanium", "Obsidian"],
                desc: "Edisi eksklusif dengan sentuhan bahan stainless brushed anti sidik jari. Mewah untuk rapat dan meja kerja."
            }
        ];

        // Cart State
        let cart = [];
        let selectedCategory = 'all';

        // Format Currency
        function formatRupiah(amount) {
            return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(amount);
        }

        // Render Products
        function renderProducts() {
            const grid = document.getElementById('product-grid');
            grid.innerHTML = '';

            const filtered = selectedCategory === 'all' 
                ? products 
                : products.filter(p => p.category === selectedCategory);

            filtered.forEach(product => {
                const card = document.createElement('div');
                card.className = "bg-white rounded-3xl p-5 border border-slate-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group";
                
                card.innerHTML = `
                    <div>
                        <!-- Product Image Box -->
                        <div class="relative w-full h-64 bg-slate-100 rounded-2xl overflow-hidden mb-5">
                            <img src="${product.image}" alt="${product.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <span class="absolute top-3 left-3 bg-slate-900/80 backdrop-blur-md text-white text-xs font-bold px-3 py-1 rounded-full">
                                ${product.badge}
                            </span>
                            <button onclick="openProductModal(${product.id})" class="absolute bottom-3 right-3 w-10 h-10 bg-white/90 hover:bg-white text-slate-800 rounded-full flex items-center justify-center shadow-md transition-all opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0">
                                <i class="fa-solid fa-eye text-sm"></i>
                            </button>
                        </div>

                        <!-- Product Meta -->
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-semibold uppercase text-aquora-600 bg-aquora-50 px-2.5 py-1 rounded-lg">${product.category}</span>
                            <div class="flex items-center gap-1 text-xs text-slate-500">
                                <i class="fa-solid fa-star text-amber-400"></i>
                                <span class="font-bold text-slate-800">${product.rating}</span>
                                <span>(${product.reviews})</span>
                            </div>
                        </div>

                        <!-- Product Title -->
                        <h3 class="font-bold text-slate-900 text-lg mb-2 line-clamp-1 group-hover:text-aquora-600 transition-colors">${product.name}</h3>
                        <p class="text-xs text-slate-500 line-clamp-2 mb-4 leading-relaxed">${product.desc}</p>
                    </div>

                    <div>
                        <!-- Price & Add Action -->
                        <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                            <div>
                                <p class="text-xs text-slate-400 line-through">${formatRupiah(product.originalPrice)}</p>
                                <p class="text-lg font-extrabold text-slate-900">${formatRupiah(product.price)}</p>
                            </div>
                            <button onclick="addToCart(${product.id})" class="p-3 bg-aquora-600 hover:bg-aquora-700 text-white rounded-xl shadow-md shadow-aquora-600/20 transition-all hover:scale-105">
                                <i class="fa-solid fa-plus text-sm"></i>
                            </button>
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // Filter Category Function
        function filterCategory(cat) {
            selectedCategory = cat;
            document.querySelectorAll('.filter-btn').forEach(btn => {
                if (btn.getAttribute('data-category') === cat) {
                    btn.classList.add('bg-aquora-600', 'text-white', 'shadow-sm');
                    btn.classList.remove('bg-white', 'text-slate-600');
                } else {
                    btn.classList.remove('bg-aquora-600', 'text-white', 'shadow-sm');
                    btn.classList.add('bg-white', 'text-slate-600');
                }
            });
            renderProducts();
        }

        // Add to Cart
        function addToCart(productId) {
            const product = products.find(p => p.id === productId);
            const existingItem = cart.find(item => item.id === productId);

            if (existingItem) {
                existingItem.quantity += 1;
            } else {
                cart.push({ ...product, quantity: 1, selectedColor: product.colorNames[0] });
            }

            updateCartUI();
            showToast(`"${product.name}" ditambahkan ke keranjang!`);
        }

        // Update Quantity
        function updateQuantity(productId, delta) {
            const item = cart.find(i => i.id === productId);
            if (item) {
                item.quantity += delta;
                if (item.quantity <= 0) {
                    cart = cart.filter(i => i.id !== productId);
                }
            }
            updateCartUI();
        }

        // Update Cart UI
        function updateCartUI() {
            const badge = document.getElementById('cart-badge');
            const container = document.getElementById('cart-items');
            const totalEl = document.getElementById('cart-total');

            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);

            // Update Badge
            if (totalItems > 0) {
                badge.innerText = totalItems;
                badge.classList.remove('hidden');
                badge.classList.add('flex');
            } else {
                badge.classList.add('hidden');
                badge.classList.remove('flex');
            }

            // Render Cart Items
            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 space-y-3">
                        <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto text-slate-400 text-2xl">
                            <i class="fa-solid fa-basket-shopping"></i>
                        </div>
                        <p class="text-slate-500 font-medium text-sm">Keranjang Anda masih kosong</p>
                    </div>
                `;
            } else {
                container.innerHTML = cart.map(item => `
                    <div class="flex gap-4 p-3 rounded-2xl bg-slate-50 border border-slate-100 items-center">
                        <img src="${item.image}" alt="${item.name}" class="w-16 h-16 object-cover rounded-xl">
                        <div class="flex-1 min-w-0">
                            <h4 class="font-bold text-slate-900 text-sm truncate">${item.name}</h4>
                            <p class="text-xs text-slate-500 mb-1">Warna: ${item.selectedColor}</p>
                            <p class="text-sm font-extrabold text-aquora-600">${formatRupiah(item.price)}</p>
                        </div>
                        <div class="flex items-center gap-2 bg-white border border-slate-200 rounded-lg p-1">
                            <button onclick="updateQuantity(${item.id}, -1)" class="w-6 h-6 flex items-center justify-center text-slate-600 hover:bg-slate-100 rounded">
                                <i class="fa-solid fa-minus text-xs"></i>
                            </button>
                            <span class="text-xs font-bold px-1">${item.quantity}</span>
                            <button onclick="updateQuantity(${item.id}, 1)" class="w-6 h-6 flex items-center justify-center text-slate-600 hover:bg-slate-100 rounded">
                                <i class="fa-solid fa-plus text-xs"></i>
                            </button>
                        </div>
                    </div>
                `).join('');
            }

            totalEl.innerText = formatRupiah(totalPrice);
        }

        // Toggle Cart Modal
        function toggleCart() {
            const drawer = document.getElementById('cart-drawer');
            const panel = document.getElementById('cart-panel');
            
            if (drawer.classList.contains('opacity-0')) {
                drawer.classList.remove('opacity-0', 'pointer-events-none');
                panel.classList.remove('translate-x-full');
            } else {
                drawer.classList.add('opacity-0', 'pointer-events-none');
                panel.classList.add('translate-x-full');
            }
        }

        // Product Quick View Modal
        function openProductModal(productId) {
            const product = products.find(p => p.id === productId);
            const content = document.getElementById('modal-content');

            content.innerHTML = `
                <div class="p-6 bg-slate-100 flex items-center justify-center">
                    <img src="${product.image}" alt="${product.name}" class="w-full h-64 object-cover rounded-2xl">
                </div>
                <div class="p-6 space-y-4 flex flex-col justify-between">
                    <div>
                        <span class="text-xs font-semibold text-aquora-600 bg-aquora-50 px-2.5 py-1 rounded-lg">${product.category}</span>
                        <h3 class="text-xl font-bold text-slate-900 mt-2">${product.name}</h3>
                        <p class="text-2xl font-extrabold text-aquora-600 my-2">${formatRupiah(product.price)}</p>
                        <p class="text-xs text-slate-600 leading-relaxed">${product.desc}</p>
                    </div>

                    <div class="space-y-4 pt-4 border-t border-slate-100">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-2">Pilihan Warna:</label>
                            <div class="flex gap-2">
                                ${product.colorNames.map((color, idx) => `
                                    <span class="text-xs px-3 py-1.5 rounded-lg border border-slate-200 bg-slate-50 text-slate-700 font-medium">${color}</span>
                                `).join('')}
                            </div>
                        </div>
                        <button onclick="addToCart(${product.id}); closeProductModal();" class="w-full py-3.5 bg-aquora-600 hover:bg-aquora-700 text-white font-bold rounded-xl shadow-lg transition-all flex items-center justify-center gap-2">
                            <i class="fa-solid fa-bag-shopping"></i> Tambah ke Keranjang
                        </button>
                    </div>
                </div>
            `;

            document.getElementById('product-modal').classList.remove('hidden');
        }

        function closeProductModal() {
            document.getElementById('product-modal').classList.add('hidden');
        }

        // WhatsApp Checkout Integration
        function checkoutWhatsApp() {
            if (cart.length === 0) {
                alert("Keranjang Anda kosong!");
                return;
            }

            let phoneNumber = "6281234567890"; // Ganti nomor WhatsApp Toko
            let message = "Halo Admin Aquora, saya ingin memesan tumbler berikut:\n\n";

            cart.forEach((item, index) => {
                message += `${index + 1}. *${item.name}*\n   - Warna: ${item.selectedColor}\n   - Jumlah: ${item.quantity}x\n   - Subtotal: ${formatRupiah(item.price * item.quantity)}\n\n`;
            });

            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            message += `*Total Pembayaran: ${formatRupiah(totalPrice)}*\n\nMohon informasi langkah pembayarannya. Terima kasih!`;

            const encodedMessage = encodeURIComponent(message);
            window.open(`https://wa.me/${phoneNumber}?text=${encodedMessage}`, '_blank');
        }

        // Toast Notification
        function showToast(msg) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-message');
            
            toastMsg.innerText = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');

            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        // Mobile Menu Toggle
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        // Subscribe Handler
        function handleSubscribe(e) {
            e.preventDefault();
            showToast("Terima kasih telah berlangganan buletin Aquora!");
            e.target.reset();
        }

        // Initialize App
        document.addEventListener('DOMContentLoaded', () => {
            renderProducts();
            updateCartUI();
        });
    </script>
</body>
</html>
